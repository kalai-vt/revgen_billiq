{
  "services": {
    "billing-app": {
      "root": "billing-app",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/billiq/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "admin-portal": {
      "root": "admin-portal",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/admin/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/admin(/.*)?",
      "destination": {
        "type": "service",
        "service": "admin-portal"
      }
    },
    {
      "source": "/billiq(/.*)?",
      "destination": {
        "type": "service",
        "service": "billing-app"
      }
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/billiq",
      "permanent": false
    }
  ]
}
