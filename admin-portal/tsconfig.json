{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/*"],
      "@base-ui/react/*": ["node_modules/@base-ui/react/*"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"],
      "react": ["node_modules/@types/react"],
      "react-dom": ["node_modules/@types/react-dom"],
      "class-variance-authority": ["node_modules/class-variance-authority"],
      "lucide-react": ["node_modules/lucide-react"],
      "next-themes": ["node_modules/next-themes"],
      "sonner": ["node_modules/sonner"]
    }
  },
  "include": ["src", "../shared"],
  // Test files (and their support code under src/test/) are type-checked separately via
  // tsconfig.vitest.json — keeping them out of the production `tsc -b` build means the shipped
  // app's type-check surface never depends on vitest/@testing-library devDependencies.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
