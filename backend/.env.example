# Copy this file to .env and fill in real values. Never commit the real .env.
REVGENIQ_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REVGENIQ_JWT_SECRET=replace-with-a-generated-32-byte-hex-secret
REVGENIQ_JWT_ALGORITHM=HS256
# Encrypts Commerce Integration credentials (Swiggy/Zomato API keys) at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVGENIQ_COMMERCE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
REVGENIQ_ACCESS_TOKEN_EXPIRE_MINUTES=30
REVGENIQ_REFRESH_TOKEN_EXPIRE_DAYS=7
REVGENIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REVGENIQ_DATABASE_URL=sqlite:///./app.db

# RevGenIQ Admin Portal: separate database and separate JWT secret from the tenant-facing app, so
# a leak of one credential store can't forge tokens for the other. Generate the secret with:
# python -c "import secrets; print(secrets.token_hex(32))"
REVGENIQ_ADMIN_DATABASE_URL=sqlite:///./admin.db
REVGENIQ_ADMIN_JWT_SECRET=replace-with-a-generated-32-byte-hex-secret

REVGENIQ_VERIFICATION_TOKEN_EXPIRY_HOURS=24
REVGENIQ_PASSWORD_RESET_EXPIRY_MINUTES=15
REVGENIQ_SUPPORT_EMAIL=support@yourdomain.com

# Public URLs used to build links inside emails (verify-email, reset-password, admin invite).
REVGENIQ_APP_URL=http://localhost:5173
REVGENIQ_ADMIN_PORTAL_URL=http://localhost:5174

# Transactional email. Defaults to "console" (prints the email instead of sending it) — fine for
# local dev, but registration/forgot-password emails will NOT be delivered anywhere this is left
# unset, including production. Set to "resend" or "smtp" and fill in the matching credentials
# below before deploying anywhere real users will sign up.
REVGENIQ_EMAIL_PROVIDER=console
REVGENIQ_EMAIL_FROM=no-reply@yourdomain.com
# --- REVGENIQ_EMAIL_PROVIDER=resend ---
REVGENIQ_RESEND_API_KEY=
# --- REVGENIQ_EMAIL_PROVIDER=smtp ---
REVGENIQ_SMTP_HOST=
REVGENIQ_SMTP_PORT=587
REVGENIQ_SMTP_USERNAME=
REVGENIQ_SMTP_PASSWORD=

# Error tracking (Sentry). Optional — leave blank and it's never initialized, no account needed.
REVGENIQ_SENTRY_DSN=

# Subscription billing (Razorpay). Optional — leave all three blank and the "pay for your plan
# online" flow returns a clear "not configured" error; Super Admins can still assign/change plans
# manually either way. Get these from the Razorpay dashboard.
REVGENIQ_RAZORPAY_KEY_ID=
REVGENIQ_RAZORPAY_KEY_SECRET=
REVGENIQ_RAZORPAY_WEBHOOK_SECRET=

# Secures the daily subscription-check cron endpoint (GET /api/internal/cron/subscription-check).
# Deliberately NOT REVGENIQ_-prefixed: Vercel Cron Jobs auto-attach this exact env var, if set, as
# `Authorization: Bearer <value>` on every cron-triggered request — the name must match exactly
# for that auto-injection to work. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=
